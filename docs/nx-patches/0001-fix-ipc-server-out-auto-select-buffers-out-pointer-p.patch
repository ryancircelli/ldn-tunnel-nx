         let send_buffer_count = (*command_header).get_send_buffer_count();
         ipc_buf = read_array_from_buffer(ipc_buf, send_buffer_count, &mut ctx.send_buffers);
         let receive_buffer_count = (*command_header).get_receive_buffer_count();
