 const MAX_COUNT: usize = wait::MAX_OBJECT_COUNT as usize;
 
+/// Asks the server manager to hold the current request without replying, and to dispatch it
+/// again (same message, same pointer-buffer contents, [`ServerContext::resumed`] set) once
+/// `wait_handle` signals or `deadline` passes, whichever comes first.
+///
+/// `wait_handle` must be a readable event (or async-request event) the handler owns. When it
+/// signals, the manager clears it (`svcResetSignal`) and then resumes every request deferred on
+/// it, so several sessions can share one event without losing a wakeup: anything that happens
+/// after the clear signals it again.
+#[derive(Copy, Clone, Debug)]
+pub struct Deferral {
+    /// Handle to wait on, or [`svc::INVALID_HANDLE`] for a pure timeout.
+    pub wait_handle: svc::Handle,
+    /// Absolute deadline in system ticks ([`crate::arm::get_system_tick`]); `u64::MAX` for none.
+    pub deadline: u64,
+}
+
+struct DeferredRequest {
+    deferral: Deferral,
+    msg: [u8; 0x100],
+    pointer_data: Vec<u8>,
+}
