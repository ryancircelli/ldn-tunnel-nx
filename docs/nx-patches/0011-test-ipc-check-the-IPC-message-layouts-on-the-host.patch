index 0000000..74e7fb0
--- /dev/null
+++ b/src/ipc_host/svc_asm.rs
@@ -0,0 +1,505 @@
+//! Host build (crates/ipc-tests) of `svc/asm.rs`: same signatures, no `svc` instructions.
+//! The few SVCs the IPC layer issues go to the host kernel model (`ipc_host::kernel`); any other
+//! panics. Generated from svc/asm.rs; regenerate if a signature there changes.
+#![allow(unused_variables, clippy::missing_safety_doc)]
+
+use crate::result::ResultCode;
+use crate::svc::{CreateProcessInfo, DebugThreadParam, SystemInfoParam};
+use crate::{arm, svc::PhysicalMemoryInfo};
+
+use super::{
+    BreakReason, CodeMapOperation, DebugEvent, Handle, InfoId, LastThreadContext,
+    LimitableResource, MemoryAttribute, MemoryInfo, MemoryPermission, PageInfo, SchedulerState,
+};
+
+pub unsafe extern "C" fn set_heap_size(out_address: *mut *mut u8, size: usize) -> ResultCode {
+    crate::ipc_host::kernel::unsupported("set_heap_size")
